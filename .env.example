NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutor_db

# Used only by `bun run db:seed`; never accepted by public registration.
ADMIN_EMAIL=admin@tutor.com
ADMIN_PASS=Admin@1234

# Sarvam Saaras v3 STT
SARVAM_API_KEY=

# OpenAI GPT tutor responses
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=1024

# Sarvam Bulbul v3 speech synthesis
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=te-IN
MAX_TTS_INPUT_CHARS=420
MAX_TTS_AUDIO_BYTES=500000

RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
